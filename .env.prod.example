###############################################################################
# Variables que lee docker-compose.prod.yml en el Droplet.
# Copia a .env (en la raiz del repo, junto al docker-compose.prod.yml)
# y rellena los valores. Estos valores DEBEN coincidir con los de
# backend/.env (DB_DATABASE, DB_USERNAME, DB_PASSWORD).
###############################################################################

DB_ROOT_PASSWORD=wedding_root
DB_DATABASE=wedding_planner
DB_USERNAME=wedding_user
DB_PASSWORD=wedding_pass

