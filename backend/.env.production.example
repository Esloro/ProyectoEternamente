###############################################################################
# Wedding Planner - Plantilla de variables para PRODUCCION (DigitalOcean)
# ---------------------------------------------------------------------------
# Copia este archivo a .env en el servidor y rellena los valores marcados
# con CAMBIAR_*. NUNCA commitees el .env real al repositorio.
###############################################################################

APP_NAME="Wedding Planner"
APP_ENV=production
# APP_KEY lo genera automaticamente start-prod.sh en el primer arranque
# (o manualmente con: docker compose exec backend php artisan key:generate --force)
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Madrid
APP_URL=https://api.eternamente.tech      # dominio del backend (Droplet)
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# URL del frontend desplegado en Vercel.
# Esta variable la lee config/cors.php y los emails que enlazan al frontend.
FRONTEND_URL=https://eternamente.tech

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- MySQL en el mismo Droplet (red interna de Docker) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wedding_planner
DB_USERNAME=wedding_user
DB_PASSWORD=wedding_pass

# --- Sesion / cache / cola en BD (sin Redis para mantenerlo simple) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail: Gmail SMTP con App Password ---
# 1. Activa 2FA en https://myaccount.google.com/security
# 2. Genera contrasena de aplicacion en https://myaccount.google.com/apppasswords
# 3. Pega la contrasena de 16 caracteres (sin espacios) en MAIL_PASSWORD
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=CAMBIAR_APP_PASSWORD_GMAIL
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=tu-correo@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Sanctum: dominios permitidos para tokens ---
SANCTUM_STATEFUL_DOMAINS=eternamente.tech,api.eternamente.tech
SESSION_COOKIE=wedding_planner_session
